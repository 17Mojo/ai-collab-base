{
  "aiCollab.rulesDir": "./rules",
  "aiCollab.logsDir": "./logs",
  "aiCollab.stateFile": "./logs/collaboration_state.json",
  "aiCollab.activationKeyword": "2X",
  "aiCollab.watchExtensions": [
    ".ts",
    ".tsx",
    ".js",
    ".jsx",
    ".py",
    ".go",
    ".rs",
    ".java",
    ".cs"
  ],
  "aiCollab.conflictCheckOnSave": true,
  "aiCollab.conflictCheckOnCommand": true,
  "aiCollab.showOutputPanel": true,
  "aiCollab.autoLogToGit": true,
  "aiCollab.enableCopilotIntegration": false,
  "aiCollab.enableClaudeIntegration": true,
  "[typescript]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit"
    }
  },
  "[javascript]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit"
    }
  },
  "[python]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit"
    }
  },
  "python.defaultInterpreterPath": "/Users/raymondna/anaconda3/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.languageServer": "Pylance",
  "files.associations": {
    "*.ai-log": "markdown"
  },
  "files.exclude": {
    "**/.git/ai-collab": true
  },
  "editor.rulers": [
    80,
    100,
    120
  ],
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "diffEditor.renderSideBySide": true,
  "claudeCode.useTerminal": true
}