{
  "version": "3.0.0",
  "rulesDir": "./rules",
  "logsDir": "./logs",
  "stateFile": "./logs/collaboration_state.json",
  "orchestrationFile": "./config/agent-orchestration.json",
  "activationKeyword": "2X",
  "conflictCheckOnSave": true,
  "conflictCheckOnCommand": true,
  "roleOrchestration": {
    "configPath": "./config/agent-orchestration.json",
    "templatePath": "./config/agent-orchestration.template.json",
    "schemaPath": "./config/agent-orchestration.schema.json",
    "coldStartRequired": true,
    "menuSkillPath": "./collaboration/skills/menu_skill.md"
  },
  "defaultRoles": [
    "AGENT_EXEC",
    "AGENT_ARCH",
    "AGENT_TEST"
  ],
  "commandPrefixes": {
    "A.RUN": "AGENT_EXEC",
    "X.RUN": "AGENT_ARCH",
    "C.RUN": "AGENT_TEST"
  },
  "sessionOrchestration": {
    "codeartsAdapter": {
      "enabled": true,
      "bridgeCommand": "python3 scripts/codearts_bridge_deliver.py --workspace {workspace} --event-file {event_file} --artifact-file {artifact_file} --intervention-id {intervention_id} --session-id {session_id} --assignee {assignee} --reason-code {reason_code} --channel \"{channel}\" --model \"{model}\" --model-fallback \"{model_fallback}\"",
      "models": [
        {
          "providerID": "inferhub-provider",
          "modelID": "glm-5.3"
        },
        {
          "providerID": "inferhub-provider",
          "modelID": "deepseek-v4.1-flash"
        },
        {
          "providerID": "inferhub-provider",
          "modelID": "kimi-k3"
        }
      ],
      "modelPolicy": "round_robin",
      "deliveryStatusOnSuccess": "queued_for_delivery",
      "report": "logs/codearts_adapter_report.json",
      "history": "logs/codearts_adapter_history.jsonl",
      "summary": "collaboration/monitoring/CODEARTS_ADAPTER_SUMMARY_latest.md",
      "eventDir": "collaboration/monitoring/codearts_pull_events"
    }
  },
  "concurrentGuard": {
    "enabled": true,
    "expectedBranch": null,
    "requireBaselineCommit": false,
    "baselineCommit": null,
    "watchPaths": [],
    "sessionStartedAt": null,
    "foreignChangeSeverity": "warning",
    "aheadWarnThreshold": 20,
    "report": "logs/workspace_forensics/concurrent_guard_latest.json",
    "history": "logs/workspace_forensics/concurrent_guard_history.jsonl"
  }
}
