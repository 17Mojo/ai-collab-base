{
  "manifest_version": 3,
  "name": "AI Collab System - Prompt Pack",
  "version": "1.0.0",
  "description": "AI Chat Automation with 11 Platform Adapters, NotebookLM Integration, and Pack Workflow Engine",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://kimi.moonshot.cn/*",
    "https://kimi.com/*",
    "https://qianwen.aliyun.com/*",
    "https://tongyi.aliyun.com/*",
    "https://qianwen.com/*",
    "https://yiyan.baidu.com/*",
    "https://chatglm.cn/*",
    "https://yuanbao.tencent.com/*",
    "https://longcat.ai/*",
    "https://longcat.chat/*",
    "https://chat.deepseek.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://kimi.moonshot.cn/*",
        "https://kimi.com/*",
        "https://qianwen.aliyun.com/*",
        "https://tongyi.aliyun.com/*",
        "https://qianwen.com/*",
        "https://yiyan.baidu.com/*",
        "https://chatglm.cn/*",
        "https://yuanbao.tencent.com/*",
        "https://longcat.ai/*",
        "https://longcat.chat/*",
        "https://chat.deepseek.com/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
