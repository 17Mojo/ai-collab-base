{
  "metadata": {
    "pack_id": "weibo-explosive-copy",
    "pack_name": "微博爆文生成包",
    "version": "2.0.0",
    "type": "creative",
    "description": "专为微博营销推文设计的爆文生成工具，支持热点追踪、情绪煽动、话题植入",
    "designer": "AI Collab Team",
    "created_at": "2026-04-04T10:00:00",
    "updated_at": "2026-04-04T10:00:00",
    "category": "社交媒体营销",
    "tags": ["微博", "爆文", "营销", "热点", "话题"],
    "language": "zh",
    "estimated_efficiency_gain": "90%"
  },
  "domain": {
    "primary_domain": "微博内容运营",
    "secondary_domains": ["热点营销", "品牌推广", "KOL运营"],
    "target_platforms": ["weibo"],
    "target_audience": "品牌运营、KOL、营销人员",
    "brand_tone": "热点、情绪、传播",
    "compliance_rules": [
      "禁止虚假热点",
      "需标明广告性质",
      "符合微博社区规范",
      "避免敏感词汇"
    ]
  },
  "workflow": {
    "steps": [
      {
        "id": "step_1_input",
        "name": "热点/主题输入",
        "type": "local",
        "description": "输入热点话题或发布主题",
        "input_fields": ["hot_topic", "angle", "brand", "target_emotion"],
        "output_field": "topic_info",
        "ai_models": null,
        "parallel": false,
        "cross_review": false,
        "validation_criteria": null,
        "fusion_rules": null,
        "estimated_time": 20,
        "auto_trigger": false,
        "trigger_delay": null,
        "config": {
          "required_fields": ["hot_topic", "angle"],
          "optional_fields": ["brand", "target_emotion"]
        }
      },
      {
        "id": "step_2_analysis",
        "name": "热点趋势分析",
        "type": "analysis",
        "description": "分析热点趋势和用户关注点",
        "input_fields": ["topic_info"],
        "output_field": "trend_analysis",
        "ai_models": ["qianwen", "kimi"],
        "parallel": true,
        "cross_review": false,
        "validation_criteria": null,
        "fusion_rules": null,
        "estimated_time": 40,
        "auto_trigger": true,
        "trigger_delay": 5,
        "config": {
          "analysis_dimensions": ["热度趋势", "用户情绪", "讨论焦点", "潜在争议"]
        }
      },
      {
        "id": "step_3_generation",
        "name": "多角度爆文生成",
        "type": "generation",
        "description": "生成不同角度和情绪的爆文",
        "input_fields": ["topic_info", "trend_analysis"],
        "output_field": "draft_posts",
        "ai_models": ["qianwen", "zhipu", "chatgpt"],
        "parallel": true,
        "cross_review": false,
        "validation_criteria": null,
        "fusion_rules": null,
        "estimated_time": 60,
        "auto_trigger": true,
        "trigger_delay": 10,
        "config": {
          "output_versions": 3,
          "diversity_dimensions": ["情绪角度", "叙事视角", "话题切入"]
        }
      },
      {
        "id": "step_4_validation",
        "name": "传播潜力验证",
        "type": "validation",
        "description": "验证内容的传播潜力和合规性",
        "input_fields": ["draft_posts"],
        "output_field": "validation_results",
        "ai_models": ["qianwen", "zhipu"],
        "parallel": true,
        "cross_review": true,
        "validation_criteria": [
          "传播潜力评分 >= 75",
          "情绪煽动度 >= 70",
          "合规性检查通过"
        ],
        "fusion_rules": null,
        "estimated_time": 30,
        "auto_trigger": true,
        "trigger_delay": 5,
        "config": {}
      },
      {
        "id": "step_5_fusion",
        "name": "爆文融合优化",
        "type": "fusion",
        "description": "融合最佳元素，生成最终爆文",
        "input_fields": ["draft_posts", "validation_results"],
        "output_field": "final_post",
        "ai_models": ["qianwen"],
        "parallel": false,
        "cross_review": false,
        "validation_criteria": null,
        "fusion_rules": {
          "strategy": "emotional_resonance",
          "max_length": 140,
          "include_hashtag": true,
          "include_emoji": true
        },
        "estimated_time": 25,
        "auto_trigger": true,
        "trigger_delay": 5,
        "config": {}
      },
      {
        "id": "step_6_tracking",
        "name": "传播追踪配置",
        "type": "tracking",
        "description": "配置发布后的传播效果追踪",
        "input_fields": ["final_post"],
        "output_field": "tracking_config",
        "ai_models": null,
        "parallel": false,
        "cross_review": false,
        "validation_criteria": null,
        "fusion_rules": null,
        "estimated_time": 15,
        "auto_trigger": true,
        "trigger_delay": 5,
        "config": {
          "tracking_delay_hours": 12,
          "metrics": ["reposts", "comments", "likes", "mentions", "click_rate"]
        }
      }
    ],
    "max_parallel_steps": 3,
    "allow_parallel": true
  },
  "quality_metrics": {
    "metrics": {
      "viral_potential": {
        "description": "病毒传播潜力 - 内容引发转发的可能性",
        "check_method": "engagement_prediction",
        "weight": 0.30,
        "min_threshold": 0.75
      },
      "emotional_resonance": {
        "description": "情绪共鸣度 - 激发用户情绪的能力",
        "check_method": "sentiment_analysis",
        "weight": 0.25,
        "min_threshold": 0.70
      },
      "relevance": {
        "description": "相关性 - 与热点的契合度",
        "check_method": "topic_matching",
        "weight": 0.20,
        "min_threshold": 0.85
      },
      "creativity": {
        "description": "创意度 - 角度的新颖性",
        "check_method": "novelty_analysis",
        "weight": 0.15,
        "min_threshold": 0.65
      },
      "compliance": {
        "description": "规范性 - 平台规范符合度",
        "check_method": "platform_compliance",
        "weight": 0.10,
        "min_threshold": 1.0
      }
    }
  },
  "example_library": {
    "good_examples": [
      {
        "id": "weibo_good_001",
        "input": {
          "hot_topic": "AI技术突破",
          "angle": "普通人受益",
          "brand": null,
          "target_emotion": "excitement"
        },
        "output": "刚刚被震撼到了！这个AI工具让普通人10分钟干完一整天的工作！🔥\n\n一直觉得AI是科技公司的事，今天亲自试了下，真的离我们这么近了！\n\n翻译、写文案、做表、分析数据...这些日常杂活，一个工具全搞定！\n\n感觉以后打工人要被解放了！🙌\n\n#AI工具 #效率神器 #打工人 #科技改变生活",
        "description": "情绪煽动性强，贴近普通人痛点",
        "score": 95.0,
        "validation_notes": "情绪共鸣强，传播潜力高，角度新颖"
      },
      {
        "id": "weibo_good_002",
        "input": {
          "hot_topic": "咖啡文化",
          "angle": "生活方式",
          "brand": "某咖啡品牌",
