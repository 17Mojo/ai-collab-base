        "validation_notes": "无情绪煽动，角度普通，缺乏传播潜力"
      },
      {
        "id": "weibo_bad_002",
        "input": {
          "hot_topic": "社会事件",
          "angle": "评论"
        },
        "output": "这个事件说明了我们的社会还有很多问题，需要大家共同努力解决。",
        "description": "过于严肃，不适合社交媒体",
        "score": 35.0,
        "validation_notes": "情绪基调不符，缺乏传播属性"
      }
    ],
    "few_shot_template": "输入: {topic_info}\n输出: {generated_post}\n评分要点: {quality_criteria}"
  },
  "generation_params": {
    "diversity_enhancement": true,
    "output_versions": 3,
    "diversity_dimensions": ["emotional_tone", "narrative_perspective", "topic_angle"],
    "confidence_display": true,
    "critical_facts_only": false,
    "temperature": 0.8,
    "output_format": "text",
    "require_code_blocks": false
  },
  "optimization": {
    "enabled": true,
    "strategy": "viral_optimization",
    "auto_refine_threshold": 65.0,
    "periodic_review_days": 7,
    "allowed_actions": [
      "auto_refine_low_scoring",
      "trend_based_template_adjustment",
      "example_library_update",
      "viral_factor_analysis"
    ]
  },
  "performance_tracking": {
    "enabled": true,
    "metrics": ["execution_time", "generation_success_rate", "average_quality_score", "viral_success_rate"],
    "retention_days": 30,
    "post_publish_tracking": {
      "enabled": true,
      "delay_hours": 12,
      "metrics": ["reposts", "comments", "mentions", "click_rate", "viral_index"]
    }
  },
