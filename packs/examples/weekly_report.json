        "auto_trigger": false,
        "trigger_delay": null,
        "config": {
          "smart_prioritization": true
        }
      },
      {
        "id": "step_6_output",
        "name": "周报整合输出",
        "type": "local",
        "description": "整合所有内容生成最终周报",
        "input_fields": ["work_summary", "data_analysis", "issue_summary", "next_week_plan"],
        "output_field": "final_report",
        "ai_models": null,
        "parallel": false,
        "cross_review": false,
        "validation_criteria": {
          "required_sections": ["本周工作", "数据分析", "问题风险", "下周计划"]
        },
        "fusion_rules": {
          "strategy": "sequential_merge"
        },
        "estimated_time": 10,
        "auto_trigger": false,
        "trigger_delay": null,
        "config": {
          "format": "企业周报标准格式",
          "export_formats": ["markdown", "html", "docx"]
