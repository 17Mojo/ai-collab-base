        "description": "整理和分析本周数据指标",
        "input_fields": ["metrics", "comparison_period"],
        "output_field": "data_analysis",
        "ai_models": ["gpt-4"],
        "parallel": false,
        "cross_review": false,
        "validation_criteria": {
          "required_elements": ["核心指标", "环比变化", "趋势分析"]
