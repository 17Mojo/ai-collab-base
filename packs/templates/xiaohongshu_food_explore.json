          "required_fields": ["shop_name", "address"],
          "optional_fields": ["cuisine_type", "price_range", "business_hours"]
        }
      },
      {
        "id": "step_2_analysis",
        "name": "菜品点评生成",
        "type": "ai",
        "description": "根据菜品信息生成专业点评",
        "input_fields": ["dishes", "taste_notes", "presentation"],
        "output_field": "dish_reviews",
        "ai_models": ["gpt-4", "claude-3"],
        "parallel": true,
        "cross_review": true,
        "validation_criteria": {
          "min_length": 50,
          "max_length": 500,
          "required_elements": ["口感描述", "推荐指数"]
        },
        "fusion_rules": null,
        "estimated_time": 60,
        "auto_trigger": false,
        "trigger_delay": null,
        "config": {
          "style": "小红书种草风",
          "tone": "真实体验"
        }
      },
      {
        "id": "step_3_atmosphere",
        "name": "氛围描述生成",
        "type": "ai",
        "description": "描述店铺环境和用餐氛围",
        "input_fields": ["decor_style", "ambiance", "service_quality"],
        "output_field": "atmosphere_text",
        "ai_models": ["gpt-4"],
        "parallel": false,
        "cross_review": false,
        "validation_criteria": {
          "min_length": 30,
          "max_length": 200
        },
        "fusion_rules": null,
        "estimated_time": 30,
        "auto_trigger": false,
        "trigger_delay": null,
        "config": {}
      },
      {
        "id": "step_4_photo",
        "name": "拍照建议生成",
        "type": "ai",
        "description": "提供菜品和环境的拍照建议",
        "input_fields": ["dishes", "lighting", "angles"],
        "output_field": "photo_tips",
        "ai_models": ["gpt-4"],
        "parallel": false,
        "cross_review": false,
        "validation_criteria": null,
        "fusion_rules": null,
        "estimated_time": 20,
        "auto_trigger": false,
        "trigger_delay": null,
        "config": {
          "platform": "小红书",
          "aspect_ratio": "3:4"
        }
      },
      {
        "id": "step_5_output",
        "name": "文案整合输出",
        "type": "local",
        "description": "整合所有内容生成最终文案",
        "input_fields": ["shop_info", "dish_reviews", "atmosphere_text", "photo_tips"],
        "output_field": "final_content",
        "ai_models": null,
        "parallel": false,
        "cross_review": false,
        "validation_criteria": {
          "required_sections": ["标题", "正文", "标签", "拍照建议"]
        },
        "fusion_rules": {
          "strategy": "sequential_merge",
          "deduplication": true
        },
        "estimated_time": 10,
        "auto_trigger": false,
        "trigger_delay": null,
        "config": {
          "format": "小红书笔记格式"
        }
      },
      {
        "id": "step_6_tracking",
        "name": "效果追踪",
        "type": "local",
        "description": "记录发布后的数据表现",
        "input_fields": ["post_id", "publish_time"],
        "output_field": "tracking_data",
        "ai_models": null,
        "parallel": false,
        "cross_review": false,
        "validation_criteria": null,
        "fusion_rules": null,
        "estimated_time": 5,
        "auto_trigger": true,
        "trigger_delay": 86400,
        "config": {
          "metrics": ["likes", "comments", "shares", "saves"]
        }
      }
    ]
